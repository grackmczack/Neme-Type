# Schutz des Dashboards: Anmeldung per HTTP Basic Auth. Der Platzhalter für den Vhost-Pfad wird beim Deploy ersetzt.
# Die Passwortdatei liegt im Home (nicht in neme/): Apache läuft unter einem anderen Systembenutzer und muss sie lesen können.
AuthType Basic
AuthName "Nemesis316 Statistik"
AuthUserFile __VHOST__/.neme-htpasswd
Require valid-user
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
